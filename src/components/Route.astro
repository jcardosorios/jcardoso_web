---
import { rng } from '../lib/rng';
import { stops } from '../data/ruta';
import SectionTitle from './SectionTitle.astro';

const H = 200; // alto del perfil, en px
// altura (y) de cada parada: sube hasta la cumbre; después baja un poco
const ys = [180, 140, 85, 30];
const endY = 110;

// cada parada dibuja su tramo de ruta: de su altura a la de la siguiente
function segment(i: number) {
  const rand = rng(40 + i);
  const p1 = rand() * Math.PI * 2;
  const p2 = rand() * Math.PI * 2;
  const y0 = ys[i];
  const y1 = ys[i + 1] ?? endY;
  let line = '';
  for (let x = 0; x <= 100; x += 2) {
    const t = x / 100;
    const wiggle = 0.6 * Math.sin(x * 0.35 + p1) + 0.4 * Math.sin(x * 0.9 + p2);
    const y = y0 + (y1 - y0) * t + 9 * Math.sin(t * Math.PI) * wiggle;
    line += `${x === 0 ? 'M' : 'L'}${x} ${y.toFixed(1)} `;
  }
  return { line, area: `${line}L100 ${H} L0 ${H} Z` };
}
---

<section id="ruta" aria-labelledby="ruta-title" class="gutter pt-24 pb-24 md:pt-40 md:pb-32">
  <SectionTitle id="ruta-title" eyebrow="La ruta de un proyecto" title="Cómo trabajamos" />

  <ol class="mt-12 grid gap-10 xl:mt-16 xl:grid-cols-4 xl:gap-6">
    {stops.map((s, i) => {
      const seg = segment(i);
      const last = i === stops.length - 1;
      return (
        <li class="relative border-l border-ocaso/40 pl-6 xl:border-0 xl:pl-0">
          <span class="absolute top-1 -left-1.5 size-3 bg-brasa xl:hidden" aria-hidden="true" />

          <svg
            class:list={['hidden h-50 xl:block', last ? 'w-full' : 'w-[calc(100%+1.5rem)]']}
            viewBox={`0 0 100 ${H}`}
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path d={seg.area} class="fill-ocaso" fill-opacity="0.07" />
            <path
              d={seg.line}
              fill="none"
              class="stroke-ocaso"
              stroke-width="2"
              vector-effect="non-scaling-stroke"
            />
          </svg>
          <span
            class="absolute left-0 hidden size-3 bg-brasa xl:block"
            style={`top:${ys[i] - 6}px`}
            aria-hidden="true"
          />
          <span
            class="absolute left-1.5 hidden w-px border-l border-dashed border-pergamino/25 xl:block"
            style={`top:${ys[i] + 6}px;height:${H - ys[i] - 6}px`}
            aria-hidden="true"
          />

          <p class="font-mono text-[13px] text-brasa xl:mt-3">{s.kicker}</p>
          <h3 class="mt-2 font-display text-[32px] leading-9 font-light tracking-display xl:text-[40px] xl:leading-11">
            {s.title}
          </h3>
          <p class="mt-3 max-w-70 text-bruma">{s.text}</p>
        </li>
      );
    })}
  </ol>
</section>
