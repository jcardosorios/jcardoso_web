---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="border-t border-pergamino/15 bg-medianoche">
  <div class="flex flex-col gap-3 px-4 py-7 md:flex-row md:items-center md:justify-between md:px-12">
    <Logo class="h-7 w-auto self-start text-pergamino md:self-auto" />
    <p class="font-mono text-[13px] text-piedra">© {year} · Hecho a mano en Concepción</p>
    <ul class="flex gap-6 font-mono text-[13px] text-piedra">
      <li>
        <a
          class="hover:text-pergamino"
          href="https://www.linkedin.com/in/jcardosor/"
          target="_blank"
          rel="me noopener"
        >
          LinkedIn ↗
        </a>
      </li>
      <li>
        <a
          class="hover:text-pergamino"
          href="https://github.com/jcardosorios"
          target="_blank"
          rel="me noopener"
        >
          GitHub ↗
        </a>
      </li>
      <li>
        <a class="hover:text-pergamino" href="/privacidad">
          Privacidad
        </a>
      </li>
    </ul>
  </div>
</footer>
