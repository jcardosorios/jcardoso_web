---
import { rng } from '../lib/rng';

const W = 1440;
const H = 7200;
const rand = rng(11);

const stars = Array.from({ length: 260 }, () => {
  const y = Math.sqrt(rand()) * H; // raíz: más densidad hacia abajo
  const depth = y / H;
  return {
    x: Math.round(rand() * W),
    y: Math.round(y),
    r: [0.8, 1, 1.2, 1.6][Math.floor(rand() * 4)],
    o: +(Math.min(0.85, 0.15 + depth * 0.8) * (0.5 + rand() * 0.5)).toFixed(2),
    show: depth > 0.25 || rand() > 0.7, // casi sin estrellas al principio (aún queda luz)
  };
}).filter((s) => s.show);
---

<svg
  class="absolute inset-0 -z-10 size-full"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMin slice"
  aria-hidden="true"
>
  {stars.map((s, i) => (
    <circle
      class:list={{ twinkle: i % 3 === 0 }}
      style={i % 3 === 0 ? `--d: ${(i * 0.7) % 4}s; --t: ${2 + (i % 4)}s` : undefined}
      cx={s.x}
      cy={s.y}
      r={s.r}
      fill="#F4EFE6"
      fill-opacity={s.o}
    />
  ))}
</svg>

<style>
  /* una de cada tres estrellas parpadea, con ritmo y fase propios */
  @media (prefers-reduced-motion: no-preference) {
    .twinkle {
      animation: twinkle var(--t) ease-in-out var(--d) infinite alternate;
    }
  }
  @keyframes twinkle {
    to {
      opacity: 0.08;
    }
  }
</style>
