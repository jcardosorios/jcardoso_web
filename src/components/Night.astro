---
import Stars from './Stars.astro';
---

<div class="night relative isolate">
  <Stars />
  <slot />
</div>

<style>
  .night {
    background: linear-gradient(
      180deg,
      var(--color-cerro) 0%,
      var(--color-penumbra) 18%,
      var(--color-noche) 50%,
      var(--color-madrugada) 80%,
      var(--color-medianoche) 100%
    );
  }
</style>
