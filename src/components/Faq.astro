---
import { faq } from '../data/faq';
import SectionTitle from './SectionTitle.astro';
---

<section
  id="preguntas"
  aria-labelledby="faq-title"
  class="gutter pt-24 pb-24 md:pt-40 md:pb-32 xl:grid xl:grid-cols-12 xl:gap-6"
>
  <div class="xl:col-span-5">
    <SectionTitle id="faq-title" eyebrow="Noche cerrada" title="Preguntas" />
  </div>

  <div class="mt-8 border-b border-pergamino/30 md:mt-12 xl:col-span-7 xl:mt-0 xl:pt-10">
    {faq.map((item, i) => (
      <details name="faq" open={i === 0} class="group border-t border-pergamino/30">
        <summary class="flex cursor-pointer items-center justify-between gap-4 py-6 text-lg font-medium md:text-[22px] md:leading-[30px] [&::-webkit-details-marker]:hidden">
          {item.q}
          <span aria-hidden="true" class="font-mono text-brasa group-open:hidden">
            +
          </span>
          <span aria-hidden="true" class="hidden font-mono text-brasa group-open:inline">
            −
          </span>
        </summary>
        <p class="max-w-155 pb-6 text-bruma md:text-[17px] md:leading-relaxed">{item.a}</p>
      </details>
    ))}
  </div>
</section>
