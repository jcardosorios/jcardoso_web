---
import { ridgePath, type Layer } from '../lib/ridge';
import { sheet, sheetIntro } from '../data/ficha';
import SectionTitle from './SectionTitle.astro';

// Marcador de posición: un paisaje generado hasta que haya una foto de viaje en silueta
const W = 500;
const H = 640;
const layers: Layer[] = [
  { base: 470, amp: 40, freq: 1.2, seed: 6, color: '#38465f' },
  { base: 520, amp: 35, freq: 1.7, seed: 7, color: '#2a3548' },
  { base: 580, amp: 30, freq: 1.1, seed: 8, color: '#141c20' },
];
---

<section
  id="ficha"
  aria-labelledby="ficha-title"
  class="px-4 pt-24 md:px-12 md:pt-40 xl:grid xl:grid-cols-12 xl:gap-6"
>
  <figure class="relative h-90 overflow-hidden border border-pergamino/20 md:h-120 xl:col-span-5 xl:h-160">
    <svg
      class="absolute inset-0 size-full"
      viewBox={`0 0 ${W} ${H}`}
      preserveAspectRatio="xMidYMax slice"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="ficha-sky" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#16213a" />
          <stop offset="0.55" stop-color="#4a5272" />
          <stop offset="0.8" stop-color="#c7795e" />
          <stop offset="1" stop-color="#e9a570" />
        </linearGradient>
      </defs>
      <rect width={W} height={H} fill="url(#ficha-sky)" />
      <circle cx="330" cy="470" r="22" fill="#f2c48d" />
      {layers.map((l) => (
        <path d={ridgePath(l, W, H)} fill={l.color} />
      ))}
    </svg>
    <figcaption class="absolute bottom-3.5 left-4 font-mono text-[13px] text-pergamino">
      foto de viaje (silueta) pendiente
    </figcaption>
  </figure>
  <div class="mt-10 xl:col-span-6 xl:col-start-7 xl:mt-0">
    <SectionTitle id="ficha-title" eyebrow="Noche" title="Ficha de personaje" />
    <dl class="mt-8 border-b border-pergamino/20 md:mt-10">
      {sheet.map((s) => (
        <div class="grid grid-cols-[112px_minmax(0,1fr)] gap-4 border-t border-pergamino/20 py-3.5 md:grid-cols-[160px_minmax(0,1fr)]">
          <dt class="font-mono text-xs leading-6 text-piedra">{s.label}</dt>
          <dd class="leading-6 md:text-lg">{s.value}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-8 text-lg text-niebla md:text-xl md:leading-7.5">{sheetIntro}</p>
  </div>
</section>
