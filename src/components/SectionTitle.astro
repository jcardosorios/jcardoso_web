---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  count?: string;
}

const { id, eyebrow, title, count } = Astro.props;
---

<p class="font-mono text-[13px] text-piedra">{eyebrow}</p>
<h2
  id={id}
  class="reveal mt-3 font-display text-[52px] leading-none font-light tracking-display md:text-big"
>
  {title}
  {count && (
    <sup class="ml-3 align-top font-mono text-base tracking-normal text-piedra">{count}</sup>
  )}
</h2>
