---
interface Props {
  id: string;
  title: string;
  count?: string;
}

const { id, title, count } = Astro.props;
---

<h2
  id={id}
  class="reveal font-display text-[52px] leading-none font-light tracking-display md:text-big"
>
  {title}
  {count && (
    <sup class="ml-3 align-top font-mono text-base tracking-normal text-piedra">{count}</sup>
  )}
</h2>
