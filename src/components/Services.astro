---
import { services, servicesNote } from '../data/servicios';
import SectionTitle from './SectionTitle.astro';
---

<section
  id="servicios"
  aria-labelledby="servicios-title"
  class="px-4 pt-24 md:px-12 md:pt-40 xl:grid xl:grid-cols-12 xl:gap-6"
>
  <div class="xl:col-span-5">
    <SectionTitle id="servicios-title" eyebrow="Anochecer" title="Servicios" />
  </div>

  <div class="mt-8 md:mt-12 xl:col-span-7 xl:mt-0 xl:pt-10">
    <ul>
      {services.map((s) => (
        <li class="grid grid-cols-[32px_1fr] gap-x-3 gap-y-2 border-t border-pergamino/30 py-6 md:grid-cols-[48px_1fr] md:gap-x-6 md:py-7 xl:grid-cols-[48px_1fr_300px] xl:items-baseline">
          <span class="font-mono text-[13px] text-brasa">{s.key}.</span>
          <h3 class="font-display text-[28px] leading-8 font-light tracking-[-0.015em] md:text-4xl md:leading-10">
            {s.title}
          </h3>
          <p class="col-start-2 text-bruma xl:col-start-3">{s.text}</p>
        </li>
      ))}
    </ul>
    <p class="border-t border-pergamino/30 pt-5 font-mono text-[13px] text-piedra">
      {servicesNote}
    </p>
  </div>
</section>
