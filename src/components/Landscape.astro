---
import { ridgePath, type Layer } from '../lib/ridge';

const W = 1440;
const H = 900;

// de la más lejana (clara) a la más cercana (oscura)
const layers: Layer[] = [
  { base: 690, amp: 70, freq: 1.1, seed: 94, color: '#4B5B7A' },
  { base: 740, amp: 60, freq: 1.6, seed: 36, color: '#38465F' },
  { base: 795, amp: 55, freq: 2.2, seed: 1, color: '#2A3548' },
];
---

<svg
  class="absolute inset-0 -z-10 size-full"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
>
  <circle class="sun" cx="1010" cy="690" r="34" fill="#F2C48D" />
  {layers.map((layer, i) => (
    <path class="layer" style={`--shift: ${[60, 36, 14][i]}px`} d={ridgePath(layer, W, H)} fill={layer.color} />
  ))}
  <path
    d="M120 846 C 360 832, 520 862, 720 850 S 1060 832, 1320 852"
    stroke="#C9806A"
    stroke-opacity="0.55"
    stroke-width="3"
    fill="none"
  />
</svg>

<style>
  /* al bajar, el sol se esconde tras el cerro y las capas se separan; solo si el navegador lo soporta */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .sun,
      .layer {
        animation: sink linear both;
      }
      /* regla aparte y más específica: si no, el minificador la funde en el shorthand y algunos navegadores la descartan */
      svg .sun,
      svg .layer {
        animation-timeline: scroll(root);
        animation-range: 0 90svh;
      }
      .sun {
        --shift: 130px;
      }
    }
  }
  @keyframes sink {
    to {
      transform: translateY(var(--shift));
    }
  }
</style>
