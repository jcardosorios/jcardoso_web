---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import StreamingDiagram from './StreamingDiagram.astro';

interface Props {
  caso: CollectionEntry<'casos'>;
  flip?: boolean; // alterna el lado de la imagen
}
const { caso, flip = false } = Astro.props;
const { data } = caso;
const index = String(data.order).padStart(2, '0');
---

<article class="mt-12 grid gap-5 md:mt-20 md:grid-cols-12 md:gap-6">
  <div class:list={['relative md:col-span-7', flip && 'md:col-start-6 md:row-start-1']}>
    {data.diagram ? (
      <StreamingDiagram />
    ) : (
      data.cover && (
        <Image
          src={data.cover}
          alt={data.coverAlt ?? ''}
          widths={[600, 900, 1200]}
          sizes="(min-width: 768px) 58vw, 100vw"
          class="h-65 w-full border border-pergamino/20 object-cover object-top md:h-130"
        />
      )
    )}
    {data.callout && (
      <p class="absolute -bottom-3.5 left-6 hidden border border-brasa bg-noche px-2 py-1 font-mono text-xs md:block">
        {data.callout}
      </p>
    )}
  </div>

  <div
    class:list={[
      'flex flex-col gap-5 md:col-span-4 md:pt-2',
      flip ? 'md:col-start-1 md:row-start-1' : 'md:col-start-9',
    ]}
  >
    <span class="font-mono text-[13px] text-brasa">{index}</span>
    <h3 class="font-display text-4xl leading-tight font-light tracking-display md:text-ttl">
      {data.title}
    </h3>

    <dl class="border-b border-pergamino/20">
      {data.spec.map((s) => (
        <div class="grid grid-cols-[88px_1fr] gap-4 border-t border-pergamino/20 py-3 md:grid-cols-[110px_1fr]">
          <dt class="font-mono text-xs leading-[22px] text-piedra">{s.label}</dt>
          <dd class="leading-[22px]">{s.value}</dd>
        </div>
      ))}
    </dl>

    <div class="grid gap-3 md:grid-cols-2 md:gap-5">
      <div>
        <p class="font-mono text-xs text-piedra">{data.before.label}</p>
        <p class="mt-1 text-niebla">{data.before.text}</p>
      </div>
      <div>
        <p class="font-mono text-xs text-brasa">{data.after.label}</p>
        <p class="mt-1 text-niebla">{data.after.text}</p>
      </div>
    </div>

    <a
      href={`/casos/${caso.id}`}
      class="self-start border-b-[1.5px] border-ocaso pb-0.5 font-medium"
    >
      Ver caso <span aria-hidden="true">→</span>
      <span class="sr-only">: {data.title}</span>
    </a>
  </div>
</article>
