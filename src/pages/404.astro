---
import Base from '../layouts/Base.astro';
import Night from '../components/Night.astro';
---

<Base
  title="Página no encontrada | Joaquín Cardoso"
  description="Esta página no existe o se movió de lugar."
>
  <Night>
    <section class="flex min-h-dvh flex-col justify-center px-4 pt-32 pb-24 md:px-12">
      <p class="font-mono text-[13px] text-brasa">Error 404</p>
      <h1 class="mt-4 max-w-300 font-display text-[52px] leading-none font-light tracking-display md:text-[88px] xl:text-big">
        Te saliste del sendero<span class="text-brasa">.</span>
      </h1>
      <p class="mt-6 max-w-150 text-lg text-niebla md:text-xl md:leading-7.5">
        Esta página no existe o se movió de lugar. Vuelve al camino principal y retomamos desde ahí.
      </p>

      <div class="mt-10 flex flex-col gap-4 md:flex-row md:items-center md:gap-7">
        <a
          href="/"
          class="inline-flex h-14 items-center justify-center bg-pergamino px-7 font-medium text-tinta transition-colors hover:bg-ocaso"
        >
          Volver al inicio
        </a>
        <a
          href="/#casos"
          class="hit-area self-start border-b-[1.5px] border-ocaso pb-0.5 font-medium"
        >
          Ver casos <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </Night>
</Base>
