---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Night from '../components/Night.astro';
import Facts from '../components/Facts.astro';
import CaseRow from '../components/CaseRow.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Services from '../components/Services.astro';
import Route from '../components/Route.astro';
import CharacterSheet from '../components/CharacterSheet.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Escena from '../components/Escena.astro';
import { contact } from '../data/contacto';

const casos = (await getCollection('casos')).sort((a, b) => a.data.order - b.data.order);

const site = Astro.site!.href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site}#joaquin`,
      name: 'Joaquín Cardoso',
      jobTitle: 'Desarrollador web',
      url: site,
      sameAs: ['https://www.linkedin.com/in/jcardosor/', 'https://github.com/jcardosorios'],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${site}#servicio`,
      name: 'Joaquín Cardoso · Desarrollo web',
      url: site,
      description:
        'Sitios web rápidos, fáciles de editar y pensados para Google, para pymes de Chile.',
      email: contact.email,
      areaServed: { '@type': 'Country', name: 'Chile' },
      address: { '@type': 'PostalAddress', addressLocality: 'Concepción', addressCountry: 'CL' },
      founder: { '@id': `${site}#joaquin` },
    },
  ],
};
---

<Base
  title="Joaquín Cardoso · Desarrollo web para pymes"
  description="Sitios web rápidos, fáciles de editar y pensados para Google. Desarrollo web para pymes desde Concepción, Chile."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <Night>
    <Escena />
    <Hero />
    <div class="tramo" aria-hidden="true"></div>
    <Facts />

    <section id="casos" aria-labelledby="casos-title" class="gutter pt-24 pb-24 md:pt-40">
      <SectionTitle
        id="casos-title"
        title="Casos"
        count={`(${String(casos.length).padStart(2, '0')})`}
      />
      {casos.map((caso, i) => (
        <CaseRow caso={caso} flip={i % 2 === 1} />
      ))}
    </section>

    <Services />
    <Route />
    <CharacterSheet />
    <Faq />
    <Contact />
  </Night>
</Base>
